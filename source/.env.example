# Optional: copy to .env.local. Keep private keys out of source and exports.
# By default the backend reads GeminiKey1 from this game's private INI in memory.
LLAI_GAME_DIR="C:\Program Files (x86)\Steam\steamapps\common\Grand Theft Auto V Enhanced"
# GEMINI_API_KEY=your_private_key_if_you_do_not_use_the_installed_game_settings
GEMINI_TEXT_MODEL=gemini-3.8-flash
# The compiled Enhanced client expects port 3000. Keep 8765 for the original voice bridge.
LLAI_COMPANION_PORT=3000
# Optional offline mode skips key lookup and uses explicitly labelled simulation responses.
LLAI_DISABLE_GEMINI=false
# Optional original Firebase profile sign-in; disabled for this local package.
# Enabling requires your own Firebase project configuration and authorized localhost domain.
VITE_ENABLE_FIREBASE=false
